{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soturine.local/contracts/mqtt/telemetry.schema.json",
  "title": "Current ESP32 telemetry payload",
  "type": "object",
  "required": [
    "device_uid", "device_id", "timestamp", "ax", "ay", "az", "gx", "gy", "gz",
    "accel_magnitude", "gyro_magnitude", "pitch_deg", "roll_deg",
    "battery_percent_source", "detector_mode", "threshold_profile",
    "sample_interval_ms", "telemetry_interval_ms", "fft_enabled",
    "wifi_rssi", "sample_seq", "sensor_ready", "sensor_valid",
    "sensor_read_ok", "sensor_sample_age_ms", "sensor_failures",
    "i2c_error_count", "i2c_recovery_count", "i2c_last_error"
  ],
  "properties": {
    "schema_version": { "const": 1, "description": "Optional during migration; absent means implicit profile 0." },
    "device_uid": { "type": "string", "minLength": 1, "maxLength": 160 },
    "device_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "ax": { "type": "number", "description": "g" },
    "ay": { "type": "number", "description": "g" },
    "az": { "type": "number", "description": "g" },
    "gx": { "type": "number", "description": "deg/s" },
    "gy": { "type": "number", "description": "deg/s" },
    "gz": { "type": "number", "description": "deg/s" },
    "accel_magnitude": { "type": "number", "minimum": 0, "description": "g" },
    "gyro_magnitude": { "type": "number", "minimum": 0, "description": "deg/s" },
    "pitch_deg": { "type": "number", "minimum": -180, "maximum": 180 },
    "roll_deg": { "type": "number", "minimum": -180, "maximum": 180 },
    "battery_level": { "type": "number", "minimum": 0, "maximum": 100 },
    "battery_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "battery_percent_source": { "enum": ["manual", "not_configured", "manual_estimated", "estimated", "automatic", "adc", "fuel_gauge"] },
    "detector_mode": { "enum": ["normal", "demo"] },
    "threshold_profile": { "enum": ["low", "normal", "high", "demo"] },
    "sample_interval_ms": { "type": "integer", "minimum": 1 },
    "telemetry_interval_ms": { "type": "integer", "minimum": 1 },
    "fft_enabled": { "type": "boolean" },
    "wifi_rssi": { "type": "integer" },
    "rssi": { "type": "integer" },
    "sample_seq": { "type": "integer", "minimum": 0 },
    "sensor_ready": { "type": "boolean" },
    "sensor_valid": { "const": true },
    "sensor_read_ok": { "type": "boolean" },
    "sensor_sample_age_ms": { "type": "integer", "minimum": 0 },
    "sensor_failures": { "type": "integer", "minimum": 0 },
    "i2c_error_count": { "type": "integer", "minimum": 0 },
    "i2c_recovery_count": { "type": "integer", "minimum": 0 },
    "i2c_last_error": { "type": "string" }
  },
  "additionalProperties": true
}
