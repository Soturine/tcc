{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soturine.local/contracts/mqtt/event.schema.json",
  "title": "Current ESP32 event payload",
  "type": "object",
  "required": [
    "device_uid", "device_id", "event_type", "event_uuid", "event_sequence",
    "sample_seq", "timestamp", "event_uptime_ms", "accel_magnitude",
    "gyro_magnitude", "immobility_confirmed", "battery_percent_source",
    "detector_mode", "threshold_profile", "sample_interval_ms",
    "telemetry_interval_ms", "fft_enabled", "algorithm", "alert_settings",
    "sensor_ready", "sensor_valid", "sensor_read_ok", "sensor_sample_age_ms",
    "sensor_failures", "i2c_error_count", "i2c_recovery_count", "i2c_last_error"
  ],
  "properties": {
    "schema_version": { "const": 1, "description": "Optional during migration; absent means implicit profile 0." },
    "device_uid": { "type": "string", "minLength": 1, "maxLength": 160 },
    "device_id": { "type": "string", "minLength": 1 },
    "event_type": { "enum": ["fall_detected", "fall_suspected", "movement_detected", "sos_pressed"] },
    "event_uuid": { "type": "string", "minLength": 1, "maxLength": 160 },
    "event_sequence": { "type": "integer", "minimum": 1 },
    "sample_seq": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "integer", "minimum": 0 },
    "event_uptime_ms": { "type": "integer", "minimum": 0 },
    "accel_magnitude": { "type": "number", "minimum": 0, "description": "g" },
    "gyro_magnitude": { "type": "number", "minimum": 0, "description": "deg/s" },
    "immobility_confirmed": { "type": "boolean" },
    "battery_percent_source": { "enum": ["manual", "not_configured", "manual_estimated", "estimated", "automatic", "adc", "fuel_gauge"] },
    "detector_mode": { "enum": ["normal", "demo"] },
    "threshold_profile": { "enum": ["low", "normal", "high", "demo"] },
    "sample_interval_ms": { "type": "integer", "minimum": 1 },
    "telemetry_interval_ms": { "type": "integer", "minimum": 1 },
    "fft_enabled": { "type": "boolean" },
    "algorithm": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "description": "Accepted in raw input but ignored as authority by the backend." },
    "message": { "type": "string" },
    "decision_source": { "type": "string", "minLength": 1 },
    "algorithm_version": { "type": "string", "minLength": 1 },
    "detected": { "type": "boolean" },
    "candidate": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 1 },
    "activity_state_estimate": { "type": "string", "minLength": 1 },
    "confidence": { "type": "null" },
    "confidence_status": { "const": "not_available" },
    "analysis_window_ms": { "type": "integer", "minimum": 0 },
    "sample_count": { "type": "integer", "minimum": 0 },
    "orientation_delta_deg": { "type": "number", "minimum": 0, "maximum": 180 },
    "alert_settings": { "type": "object", "additionalProperties": true },
    "features": { "type": "object", "additionalProperties": true },
    "features_time_domain": { "type": "object", "additionalProperties": true },
    "features_frequency_domain": { "type": "object", "additionalProperties": true },
    "linked_telemetry_window": { "type": "object", "additionalProperties": true },
    "thresholds": { "type": "object", "additionalProperties": true },
    "sensor_ready": { "type": "boolean" },
    "sensor_valid": { "type": "boolean" },
    "sensor_read_ok": { "type": "boolean" },
    "sensor_sample_age_ms": { "type": "integer", "minimum": 0 },
    "sensor_failures": { "type": "integer", "minimum": 0 },
    "i2c_error_count": { "type": "integer", "minimum": 0 },
    "i2c_recovery_count": { "type": "integer", "minimum": 0 },
    "i2c_last_error": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "enum": ["fall_detected", "fall_suspected", "movement_detected"] } } },
      "then": {
        "required": [
          "decision_source", "algorithm_version", "detected", "candidate", "reason",
          "activity_state_estimate", "confidence", "confidence_status",
          "analysis_window_ms", "sample_count", "orientation_delta_deg",
          "features_time_domain", "features_frequency_domain", "thresholds"
        ]
      }
    }
  ],
  "additionalProperties": true
}
