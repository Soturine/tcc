{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soturine.local/contracts/mqtt/status.schema.json",
  "title": "Current ESP32 status payload",
  "type": "object",
  "required": [
    "device_uid", "device_id", "event_type", "timestamp",
    "battery_percent_source", "detector_mode", "threshold_profile",
    "sample_interval_ms", "telemetry_interval_ms", "fft_enabled",
    "wifi_rssi", "buffered_events", "sample_seq", "sensor_ready",
    "sensor_valid", "sensor_read_ok", "sensor_sample_age_ms",
    "sensor_failures", "i2c_error_count", "i2c_recovery_count",
    "i2c_last_error"
  ],
  "properties": {
    "schema_version": { "const": 1, "description": "Optional during migration; absent means implicit profile 0." },
    "device_uid": { "type": "string", "minLength": 1, "maxLength": 160 },
    "device_id": { "type": "string", "minLength": 1 },
    "event_type": { "const": "device_status" },
    "timestamp": { "type": "integer", "minimum": 0 },
    "accel_magnitude": { "type": "number" },
    "gyro_magnitude": { "type": "number" },
    "immobility_confirmed": { "type": "boolean" },
    "battery_level": { "type": "number", "minimum": 0, "maximum": 100 },
    "battery_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "battery_percent_source": { "enum": ["manual", "not_configured", "manual_estimated", "estimated", "automatic", "adc", "fuel_gauge"] },
    "battery_manual_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "battery_manual_updated_at": { "type": "integer", "minimum": 0 },
    "battery_calibration_sequence": { "type": "integer", "minimum": 0 },
    "battery_estimated_minutes_per_percent": { "type": "number", "minimum": 0 },
    "battery_estimate_mode": { "type": "string" },
    "detector_mode": { "enum": ["normal", "demo"] },
    "threshold_profile": { "enum": ["low", "normal", "high", "demo"] },
    "sample_interval_ms": { "type": "integer", "minimum": 1 },
    "telemetry_interval_ms": { "type": "integer", "minimum": 1 },
    "fft_enabled": { "type": "boolean" },
    "wifi_rssi": { "type": "integer" },
    "rssi": { "type": "integer" },
    "buffered_events": { "type": "integer", "minimum": 0, "description": "Pending critical outbox items (compatibility field)." },
    "boot_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "critical_outbox": {
      "type": "object",
      "required": ["pending", "capacity", "not_persisted", "store_available", "overflow_count", "ack_subscribed"],
      "properties": {
        "pending": { "type": "integer", "minimum": 0 },
        "capacity": { "type": "integer", "minimum": 1 },
        "not_persisted": { "type": "integer", "minimum": 0 },
        "store_available": { "type": "boolean" },
        "oldest_age_ms": { "type": "integer", "minimum": 0 },
        "overflow_count": { "type": "integer", "minimum": 0 },
        "too_large_count": { "type": "integer", "minimum": 0 },
        "persist_failures": { "type": "integer", "minimum": 0 },
        "corrupted_on_load": { "type": "integer", "minimum": 0 },
        "acked": { "type": "integer", "minimum": 0 },
        "duplicate_acks": { "type": "integer", "minimum": 0 },
        "unknown_acks": { "type": "integer", "minimum": 0 },
        "invalid_acks": { "type": "integer", "minimum": 0 },
        "last_ack_age_ms": { "type": ["integer", "null"], "minimum": 0 },
        "ack_subscribed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "sample_seq": { "type": "integer", "minimum": 0 },
    "sensor_ready": { "type": "boolean" },
    "sensor_valid": { "type": "boolean" },
    "sensor_read_ok": { "type": "boolean" },
    "sensor_sample_age_ms": { "type": "integer", "minimum": 0 },
    "sensor_failures": { "type": "integer", "minimum": 0 },
    "i2c_error_count": { "type": "integer", "minimum": 0 },
    "i2c_recovery_count": { "type": "integer", "minimum": 0 },
    "i2c_last_error": { "type": "string" },
    "firmware_version": { "type": "string" }
  },
  "additionalProperties": true
}
